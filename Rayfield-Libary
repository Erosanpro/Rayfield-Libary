-- Rayfield GUI Loader Fix

local getService = game.GetService or game.getService
local CoreGui = getService(game, "CoreGui")
local useStudio = false
local InterfaceBuild = "1.0.0"

local Rayfield = useStudio and script.Parent:FindFirstChild('Rayfield') or game:GetObjects("rbxassetid://10804731440")[1]
local buildAttempts, correctBuild, warned = 0, false, false

repeat
	if Rayfield and Rayfield:FindFirstChild("Build") and Rayfield.Build.Value == InterfaceBuild then
		correctBuild = true
		break
	end

	if not warned then
		warn('Rayfield | Build Mismatch')
		print('Rayfield may encounter issues as you are running an incompatible interface version (' ..
			((Rayfield:FindFirstChild("Build") and Rayfield.Build.Value) or "No Build") ..
			').\n\nThis version of Rayfield is intended for interface build ' .. InterfaceBuild .. '.')
		warned = true
	end

	if Rayfield and not useStudio then Rayfield:Destroy() end
	Rayfield = useStudio and script.Parent:FindFirstChild("Rayfield") or game:GetObjects("rbxassetid://10804731440")[1]
	buildAttempts += 1
until buildAttempts >= 2

if not Rayfield then
	error("Rayfield GUI could not be loaded.")
end

Rayfield.Enabled = false

if gethui then
	Rayfield.Parent = gethui()
elseif syn and syn.protect_gui then 
	syn.protect_gui(Rayfield)
	Rayfield.Parent = CoreGui
elseif not useStudio and CoreGui:FindFirstChild("RobloxGui") then
	Rayfield.Parent = CoreGui:FindFirstChild("RobloxGui")
elseif not useStudio then
	Rayfield.Parent = CoreGui
end

return Rayfield
