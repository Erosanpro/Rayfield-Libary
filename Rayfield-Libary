-- Rayfield Library (Fixed Version)
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local CoreGui = game:GetService("CoreGui")
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")

local Rayfield = {}
Rayfield.Flags = {}

local function SafePcall(f, ...)
    local success, result = pcall(f, ...)
    if not success then
        warn("[Rayfield Error]:", result)
    end
    return success and result
end

local function CreateDrawing(type, props)
    local drawing = SafePcall(Drawing.new, type)
    if not drawing then return nil end
    for i, v in pairs(props or {}) do
        SafePcall(function() drawing[i] = v end)
    end
    return drawing
end

Rayfield.CreateWindow = function(options)
    local window = {}
    window.Name = options.Name or "Rayfield UI"
    window.LoadingTitle = options.LoadingTitle or "Loading..."
    window.LoadingSubtitle = options.LoadingSubtitle or "Please wait"

    local titleText = CreateDrawing("Text", {
        Text = window.LoadingTitle,
        Size = 18,
        Color = Color3.new(1, 1, 1),
        Position = Vector2.new(100, 100),
        Visible = true
    })

    local subtitleText = CreateDrawing("Text", {
        Text = window.LoadingSubtitle,
        Size = 14,
        Color = Color3.new(0.8, 0.8, 0.8),
        Position = Vector2.new(100, 120),
        Visible = true
    })

    task.delay(3, function()
        if titleText then titleText.Visible = false end
        if subtitleText then subtitleText.Visible = false end
    end)

    return window
end

Rayfield.CreateButton = function(window, options)
    local button = {}
    button.Text = options.Text or "Button"
    button.Callback = options.Callback or function() end

    local isHeld = false
    local inputConn = nil

    inputConn = UserInputService.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            isHeld = true
            SafePcall(button.Callback)
        end
    end)

    return button
end

return Rayfield
